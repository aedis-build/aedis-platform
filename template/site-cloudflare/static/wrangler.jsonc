// Só assets estáticos (out/): nenhum código de Worker roda, então a requisição não custa nem tem limite de CPU.
// Publicado pelo deploy-site.yml do Aedis Platform; out/_headers (scripts/headers.ts) leva os cabeçalhos de segurança.
// O Worker responde só no domínio próprio: nunca em workers.dev nem em URL de versão.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__AEDIS_NAME__",
  "compatibility_date": "__AEDIS_COMPAT_DATE__",
  "assets": { "directory": "./out", "not_found_handling": "404-page" },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "__AEDIS_DOMAIN__", "custom_domain": true }]
}
